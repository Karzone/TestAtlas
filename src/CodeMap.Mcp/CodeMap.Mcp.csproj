<Project Sdk="Microsoft.NET.Sdk">

  <!-- v2 MCP server over a TestAtlas map. Packs as a dotnet tool: `testatlas-mcp`. Read-only, offline,
       zero MCP-SDK dependency (hand-rolled JSON-RPC over stdio). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TestAtlas.Mcp</RootNamespace>
    <AssemblyName>TestAtlas.Mcp</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>testatlas-mcp</ToolCommandName>
    <PackageId>TestAtlas.Mcp</PackageId>
    <!-- Also advertise as an MCP server so NuGet.org lists it under MCP and clients (VS/VS Code)
         can discover + install it. PackAsTool contributes the DotnetTool type; this adds McpServer. -->
    <PackageType>McpServer</PackageType>
    <Description>TestAtlas MCP server (`testatlas-mcp`) — serves a TestAtlas semantic map of a .NET test-automation solution to an AI agent over stdio (hand-rolled JSON-RPC, zero MCP-SDK dependency). Read-only and offline. Exposes tools to search steps and scenarios, compute change impact, list endpoints, and read map stats — so an agent can navigate a test codebase without stuffing files into context.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeMap.Core\CodeMap.Core.csproj" />
  </ItemGroup>

  <!-- MCP server manifest — packed at /.mcp/ where NuGet clients look for it. The checked-in file
       keeps a "0.0.0-dev" placeholder version; the real <Version> is stamped in at pack time by the
       target below, so the manifest version can never drift from the package version. -->
  <ItemGroup>
    <None Include="$(IntermediateOutputPath)server.json" Pack="true" PackagePath="/.mcp/server.json" Visible="false" />
  </ItemGroup>

  <Target Name="StampMcpServerManifest" BeforeTargets="GenerateNuspec;Build">
    <PropertyGroup>
      <_McpManifestSrc>$(MSBuildProjectDirectory)/.mcp/server.json</_McpManifestSrc>
      <_McpManifestOut>$(IntermediateOutputPath)server.json</_McpManifestOut>
      <_McpManifestRaw>$([System.IO.File]::ReadAllText('$(_McpManifestSrc)'))</_McpManifestRaw>
      <_McpManifestJson>$(_McpManifestRaw.Replace('0.0.0-dev', '$(Version)'))</_McpManifestJson>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_McpManifestOut)" Lines="$(_McpManifestJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
